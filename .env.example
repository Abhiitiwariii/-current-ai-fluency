# Supabase (optional). Leave unset to run the app fully local/offline —
# Google login stays hidden and feedback/emails are stored only in localStorage.
# Set BOTH to go live (locally in .env.local, and in Vercel → Project → Env Vars).
# Find these in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mixpanel (optional). Leave unset to log the funnel to localStorage only (each
# browser sees just its own data). Set this to mirror every funnel event to
# Mixpanel so drop-off is visible across ALL users. It's a PUBLIC write-only token
# (safe in the client bundle). Find it in Mixpanel → Settings → Project Settings →
# Access Keys → Project Token. Set here (.env.local) AND in Vercel → Env Vars.
NEXT_PUBLIC_MIXPANEL_TOKEN=
