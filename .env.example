# Supabase (optional). Leave unset to run the app fully local/offline —
# Google login stays hidden and feedback/emails are stored only in localStorage.
# Set BOTH to go live (locally in .env.local, and in Vercel → Project → Env Vars).
# Find these in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
